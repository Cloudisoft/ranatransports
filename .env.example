# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://www.ranatransports.in

# --- Enquiry storage (PostgreSQL) ---------------------------------------
# Run `npm run db:init` once to create the enquiries table.
DATABASE_URL=postgres://user:password@host:5432/rana

# --- Enquiry email delivery (SMTP) --------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender must be a mailbox your SMTP provider allows you to send from.
ENQUIRY_FROM="Rana Website <no-reply@ranatransports.in>"
ENQUIRY_TO=contact@ranatransports.in

# Optional: forward each verified enquiry as JSON to a CRM webhook.
CRM_WEBHOOK_URL=

# Optional: Cloudflare Turnstile spam protection (both keys required to enable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
